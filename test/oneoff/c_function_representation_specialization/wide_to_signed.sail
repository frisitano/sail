default Order dec

$include <prelude.sail>
$include <arith.sail>

type u128_value = range(0, 340282366920938463463374607431768211455)
type u256_value = range(0, 115792089237316195423570985008687907853269984665640564039457584007913129639935)
type u320_value = range(0, 2135987035920910082279229616932235919179133537347964862093771623156579161741164519270975247745025)
type i64_value = range(-9223372036854775808, 9223372036854775807)

function signed_from_u128(value : u128_value) -> i64_value =
  if value <= 9223372036854775807 then value else -9223372036854775808

function signed_from_u256(value : u256_value) -> i64_value =
  if value <= 9223372036854775807 then value else -9223372036854775808

function signed_from_u320(value : u320_value) -> i64_value =
  if value <= 9223372036854775807 then value else -9223372036854775808

function main() -> unit = ()
