{
    "comments": {
        "lineComment": "//",
        "blockComment": [ "/*", "*/" ]
    },
    "wordPattern": "[A-Za-z_][A-Za-z0-9_'#]*|[$%&*+\\-./:<=>?@^|~!]+",
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*/\\*\\s*#region\\b.*\\*/",
            "end": "^\\s*/\\*\\s*#endregion\\b.*\\*/"
        }
    },
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(.*\\b(then|do|of|struct|union|enum|scattered|mapping|function)\\b.*|.*[\\{\\(\\[]\\s*)$",
        "decreaseIndentPattern": "^\\s*(end|\\}|\\]|\\))\\b?.*$"
    }
}
